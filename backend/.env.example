# Development defaults. Copy to .env for local overrides. Never commit real secrets.
ENVIRONMENT=development

# Signing key for access tokens. Must be a long random value in staging and production.
SECRET_KEY=dev-only-insecure-secret-key-change-me
# Fernet key for encrypting MFA secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

COOKIE_SECURE=false
WEB_BASE_URL=http://localhost:3810

# Default platform administrator, created by `python -m app.cli seed`.
# The password must be changed on first sign-in. In production, set a strong
# SEED_ADMIN_PASSWORD through the deployment's secret store; the seed refuses
# weak passwords outside development.
SEED_ADMIN_USERNAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password

# Branding shown in the web app.
BRAND_PRODUCT_NAME=SME Cybersecurity Monitoring
